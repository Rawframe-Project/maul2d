# Static analysis for the Maul family. Identical in every Maul library;
# CI runs it on src/ and fails on any finding.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-branch-clone,
  -bugprone-switch-missing-default-case,
  clang-analyzer-*,
  -clang-analyzer-optin.performance.Padding,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  misc-redundant-expression,
  misc-misplaced-const,
  readability-misleading-indentation,
  readability-duplicate-include,
  readability-redundant-declaration,
  performance-no-int-to-ptr,
  readability-function-cognitive-complexity
WarningsAsErrors: '*'
CheckOptions:
  readability-function-cognitive-complexity.Threshold: 25
  readability-function-cognitive-complexity.DescribeBasicIncrements: false
HeaderFilterRegex: '(src|include)/.*'
